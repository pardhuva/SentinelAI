# SentinelAI Server Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# MongoDB (will be connected in upcoming milestone)
MONGODB_URI=mongodb://localhost:27017/sentinelai

# Redis (will be connected in background worker milestone)
REDIS_HOST=localhost
REDIS_PORT=6379

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
