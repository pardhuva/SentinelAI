# SentinelAI Server Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# API Authentication (Required in production: minimum 32-character random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENTINEL_API_KEY=your-32-char-secure-api-key-here
REQUIRE_AUTH=false

# Database Configuration
# In development: unauthenticated local instance
# In production: TLS-authenticated cluster (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/sentinelai?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017/sentinelai

# Redis & BullMQ Queue Configuration
# In development: leave USE_MOCK_REDIS=false if local Redis is available, or use in-memory queue fallback
# In production: provide authenticated TLS Redis URL (e.g. rediss://default:<password>@<host>:<port>)
# USE_MOCK_REDIS cannot be true in production.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Process Architecture (Set to false if running scan worker in a separate container)
START_WORKER=true

# Security & SSRF Policy (Strictly forced to false in production)
ALLOW_PRIVATE_TARGETS=false

# Frontend CORS Origin (Set to your exact deployed client domain in production)
CLIENT_URL=http://localhost:5173
